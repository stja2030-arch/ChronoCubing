];

function renderAlgCategories(){
 let categories=["All","Beginner","Cross","F2L","OLL","PLL","COLL","WV","VLS","ZBLL","Custom","Pyraminx"];
 $("algCategories").innerHTML=categories.map(c=>`
 <button class="${selectedAlgCategory===c?"active":""}" onclick="selectAlgCategory('${c}')">${c}</button>`).join("");
}
function selectAlgCategory(c){selectedAlgCategory=c;renderAlgCategories();renderAlgorithms()}
function renderAlgorithms(){
 let search=$("algSearch").value.toLowerCase();
 let results=algorithmDatabase.filter(a=>
  (selectedAlgCategory==="All"||a.category===selectedAlgCategory)&&
  (a.name.toLowerCase().includes(search)||a.notation.toLowerCase().includes(search)||a.description.toLowerCase().includes(search))
 );
 $("algResults").innerHTML=results.length?results.map(a=>`
 <div class="alg-card">
  <div class="topline"><b>${escapeHTML(a.name)}</b><span class="small muted">${escapeHTML(a.category)}</span></div>
  <div class="alg-notation">${escapeHTML(a.notation)}</div>
  <p class="small muted">${escapeHTML(a.description)}</p>
  <div class="alg-actions">
   <button onclick="loadAlgorithm(${algorithmDatabase.indexOf(a)})">Open in Cube Lab</button>
   <button onclick="copyText('${a.notation.replace(/\\/g,"\\\\").replace(/'/g,"\\'")}')">Copy</button>
   ${a.custom?`<button onclick="deleteAlgorithm(${algorithmDatabase.indexOf(a)})">Delete</button>`:""}
  </div>
 </div>`).join(""):'<p class="muted">No algorithms found.</p>';
}
function escapeHTML(s){
 return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
}
function loadAlgorithm(i){
 let a=algorithmDatabase[i];if(!a)return;
 cubeMoves=a.notation.trim().split(/\s+/);
 updateCube();showPage("notation");
}
function addCustomAlgorithm(){
 let name=prompt("Algorithm name:");if(!name)return;
 let notation=prompt("Enter algorithm notation:");if(!notation)return;
 let category=prompt("Category (OLL, PLL, F2L, COLL, ZBLL, Custom):","Custom")||"Custom";
 algorithmDatabase.push({name,notation,category,description:"Custom algorithm",custom:true});
 saveCustomAlgorithms();renderAlgCategories();renderAlgorithms();
}
function saveCustomAlgorithms(){
 localStorage.setItem("chrono_custom_algorithms",JSON.stringify(algorithmDatabase.filter(a=>a.custom)));
}
function deleteAlgorithm(i){
 if(!confirm("Delete this custom algorithm?"))return;
 algorithmDatabase.splice(i,1);saveCustomAlgorithms();renderAlgorithms();
}
$("algSearch").addEventListener("input",renderAlgorithms);

// ========================================
// SETTINGS
// ========================================

function applySettings(){
 let s=settings(),light=s.theme==="light";
 const vars={
  "--bg":light?"#f3f6fa":"#090d14",
  "--panel":light?"#ffffff":"#111824",
  "--panel2":light?"#e8edf5":"#182333",
  "--border":light?"#d6deea":"#29364a",
  "--text":light?"#172033":"#edf3fc",
  "--muted":light?"#63738a":"#8493a9",
  "--accent":s.accent||"#60a5fa"
 };
 Object.entries(vars).forEach(([k,v])=>document.documentElement.style.setProperty(k,v));
 $("display").style.fontSize=s.fontSize==="large"?"clamp(95px,18vw,175px)":s.fontSize==="small"?"clamp(55px,10vw,105px)":"";
 $("precision").value=s.precision??2;
 $("inspectionDuration").value=s.inspectionDuration??15;
 $("startDelay").value=s.startDelay??350;
 $("accent").value=s.accent||"#60a5fa";
 $("themeSelect").value=s.theme||"dark";
 $("fontSize").value=s.fontSize||"normal";
 $("confirmDelete").value=String(s.confirmDelete!==false);
}
function saveSettings(){
 let s=settings();
 s.precision=Number($("precision").value);
 s.inspectionDuration=Number($("inspectionDuration").value);
 s.startDelay=Math.max(100,Math.min(2000,Number($("startDelay").value)||350));
 s.accent=$("accent").value;
 s.theme=$("themeSelect").value;
 s.fontSize=$("fontSize").value;
 s.confirmDelete=$("confirmDelete").value==="true";
 save();applySettings();refresh();alert("Settings saved!");
}
function toggleTheme(){
 settings().theme=settings().theme==="light"?"dark":"light";
 save();applySettings();
}

// ========================================
// IMPORT / EXPORT
// ========================================

function download(content,name,type){
 let a=document.createElement("a");
 let url=URL.createObjectURL(new Blob([content],{type}));
 a.href=url;a.download=name;a.click();
 setTimeout(()=>URL.revokeObjectURL(url),1000);
}
function exportJSON(){download(JSON.stringify(data,null,2),"chronocubing-backup.json","application/json")}
function exportCSV(){
 let rows=[["Event","Time","Penalty","Scramble","Date"]];
 solves().forEach(s=>rows.push([s.event,(s.ms/1000).toFixed(3),s.penalty,s.scramble,s.date]));
 download(rows.map(r=>r.map(v=>'"'+String(v).replaceAll('"','""')+'"').join(",")).join("\n"),"chronocubing-solves.csv","text/csv");
}
$("importFile").onchange=async e=>{
 try{
  let imported=JSON.parse(await e.target.files[0].text());
  if(!Array.isArray(imported.sessions)||!imported.sessions.length||!imported.sessions.every(s=>Array.isArray(s.solves)))throw Error();
  if(!confirm("Replace current data?"))return;
  data=imported;save();location.reload();
 }catch{alert("Invalid backup file.")}
};
function copyText(text){
 if(navigator.clipboard?.writeText)navigator.clipboard.writeText(text).catch(()=>prompt("Copy this text:",text));
 else prompt("Copy this text:",text);
}

// ========================================
// INITIALIZATION
// ========================================

try{
 let custom=JSON.parse(localStorage.getItem("chrono_custom_algorithms")||"[]");
 if(Array.isArray(custom))algorithmDatabase.push(...custom);
}catch{}

setupMoveButtons();
renderAlgCategories();
renderAlgorithms();
applySettings();
$("eventSelect").value=session().event;
newScramble();
refresh();

customElements.whenDefined("twisty-player").then(updateCube);
</script>
