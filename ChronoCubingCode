 {name:"Sune",category:"OLL",notation:"R U R' U R U2 R'",description:"A common last-layer orientation case."},
 {name:"Anti-Sune",category:"OLL",notation:"R U2 R' U' R U' R'",description:"Sune variation."},
 {name:"T OLL",category:"OLL",notation:"r U R' U' r' F R F'",description:"T-shaped OLL case."},
 {name:"OLL Cross",category:"OLL",notation:"F R U R' U' F'",description:"Basic cross formation."},
 {name:"T Perm",category:"PLL",notation:"R U R' U' R' F R2 U' R' U' R U R' F'",description:"Two corner and two edge swaps."},
 {name:"Ua Perm",category:"PLL",notation:"R U' R U R U R U' R' U' R2",description:"Three-edge cycle."},
 {name:"Ub Perm",category:"PLL",notation:"R2 U R U R' U' R' U' R' U R'",description:"Opposite three-edge cycle."},
